# native の出典ハッシュと生成元を OS ごとの改行変換から守る。
crates/sonicop-onigmo-compat/vendor/** text eol=lf linguist-vendored=true
src/regexp_encoding_tables.rs text eol=lf linguist-generated=true

# 実 token の原本 bytes は JSON 値に保持し、記録の容器は Windows でも LF に固定する。
scripts/record_last_token_lines.py text eol=lf
tests/fixtures/last_token_lines.json text eol=lf
tests/fixtures/last_token_lines.json.PROVENANCE text eol=lf

# native の EOF 条件は明示 crlf と異なるため、Windows の実記録を別に保つ。
scripts/record_windows_end_of_line_tokens.py text eol=lf
tests/fixtures/end_of_line_tokens.json text eol=lf
tests/fixtures/end_of_line_tokens.json.PROVENANCE text eol=lf
tests/fixtures/end_of_line_tokens_windows.json text eol=lf
tests/fixtures/end_of_line_tokens_windows.json.PROVENANCE text eol=lf

# Windows Oracle の公開コンテナは LF 固定。JSON 内の hex/escape は変換しない。
scripts/conformance/record_windows_corrections.py text eol=lf
scripts/conformance/record_windows_native_cli.py text eol=lf
scripts/conformance/test_windows_corrections.py text eol=lf
scripts/conformance/test_windows_native_cli.py text eol=lf
tests/windows_corrections.rs text eol=lf
tests/fixtures/windows_corrections.json text eol=lf
tests/fixtures/windows_corrections.json.PROVENANCE text eol=lf
tests/fixtures/windows_native_cli_expectations.json text eol=lf
tests/fixtures/windows_native_cli_expectations.json.PROVENANCE text eol=lf

# 非Unicode引数の記録コンテナと生成元をLFで保ち、原本hexを変換しない。
scripts/record_non_unicode_cli_arguments.py text eol=lf
scripts/test_record_non_unicode_cli_arguments.py text eol=lf
tests/fixtures/non_unicode_cli_arguments.json text eol=lf
tests/fixtures/non_unicode_cli_arguments.PROVENANCE text eol=lf
tests/cli_arguments.rs text eol=lf

# 匿名stdinの参照記録と生成元はLFで保ち、入力hexを変換しない。
scripts/record_empty_stdin.py text eol=lf
scripts/test_record_empty_stdin.py text eol=lf
tests/empty_stdin.rs text eol=lf
tests/fixtures/empty_stdin_reports.json text eol=lf
